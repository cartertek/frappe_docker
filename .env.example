# Cartertek local/example values. For production, copy .env.production.example to .env.production.
CUSTOM_IMAGE=cartertek/frappe
CUSTOM_TAG=v17-frappe-production-YYYYMMDD
PULL_POLICY=never
ERPNEXT_VERSION=version-17
FRAPPE_SITE_NAME_HEADER=hrms.localhost
HTTP_PUBLISH_PORT=9800
DB_PASSWORD=123
DB_HOST=db
DB_PORT=3306
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379
GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m
BACKUP_CRONSTRING=@every 6h
MIGRATE_SITES=true
