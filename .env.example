# Cartertek local/example values. For production, copy .env.production.example to .env.production.
CUSTOM_IMAGE=ghcr.io/cartertek/frappe
CUSTOM_TAG=develop
# Optional explicit tag list. If empty, build script mirrors upstream aliases:
# develop -> develop latest; v17.x.y -> v17.x.y v17 version-17.
CUSTOM_TAGS=
COMPOSE_PROJECT_NAME=frappe
PULL_POLICY=never
ERPNEXT_VERSION=develop
FRAPPE_BRANCH=develop
SITE_NAME=frappe.localhost
FRAPPE_SITE_NAME_HEADER=frappe.localhost
HTTP_PUBLISH_PORT=9880
DB_PASSWORD=123
DB_HOST=db
DB_PORT=3306
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379
GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m
BACKUP_CRONSTRING=@every 6h
MIGRATE_SITES=true

# Startup backup override. If overrides/compose.backup-on-start.yaml is enabled,
# backup files are written here every time the compose stack starts.
FRAPPE_BACKUP_HOST_DIR=./backups/frappe
BACKUP_RETENTION_DAYS=7
BACKUP_HOLD_OPEN=1

# Optional Tailnet MCP Gateway access for the backend container.
TAILNET_MCP_SERVICES=
# Enable with overrides/compose.tailnet-mcp-gateway.yaml.
TAILSCALE_API_KEY=
TAILNET_MCP_SSH_HOST_DIR=./ssh
