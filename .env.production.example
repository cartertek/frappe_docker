# Cartertek Frappe production env template
# Copy to .env.production and replace all CHANGE_ME values before use.

# Custom image built from this fork using apps.json.
CUSTOM_IMAGE=ghcr.io/cartertek/frappe
CUSTOM_TAG=develop
# Optional explicit tag list. If empty, build script mirrors upstream aliases:
# develop -> develop latest; v17.x.y -> v17.x.y v17 version-17.
CUSTOM_TAGS=
COMPOSE_PROJECT_NAME=frappe
PULL_POLICY=always
RESTART_POLICY=unless-stopped

# Base app version selector used by fallback/default image references.
ERPNEXT_VERSION=develop
FRAPPE_BRANCH=develop

# Current site being migrated from the HRMS bootstrap stack.
SITE_NAME=frappe.localhost
FRAPPE_SITE_NAME_HEADER=frappe.localhost

# Local no-proxy deployment port. Change to the intended host port before cutover.
HTTP_PUBLISH_PORT=9800

# MariaDB root password for the new production stack.
DB_PASSWORD=CHANGE_ME_STRONG_DB_ROOT_PASSWORD

# Internal services provided by official compose overrides.
DB_HOST=db
DB_PORT=3306
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379

# Runtime tuning.
GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

# Backup schedule if overrides/compose.backup-cron.yaml is enabled.
BACKUP_CRONSTRING=@every 6h

# Migrator override. For initial restore, you may set false until restore is complete.
MIGRATE_SITES=true
